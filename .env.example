# Configuracion CMF Monitor (Docker)
# ===================================
# Copia este archivo a .env y completa los valores. .env NO se commitea
# (esta en .gitignore). docker compose lo lee automaticamente.

# ---- Postgres ----
# Los tres se usan para inicializar el contenedor 'db' y conectar desde 'app'.
POSTGRES_DB=cmf
POSTGRES_USER=cmf
POSTGRES_PASSWORD=cambia_esta_password

# ---- Servidor web (dashboard) ----
# Puerto del host en el que nginx publica el dashboard.
WEB_PORT=8080
# URL publica que se incluye al final de los correos.
CMF_DASHBOARD_URL=http://localhost:8080/

# ---- SMTP (correos de notificacion) ----
# Si dejas CMF_SMTP_HOST o CMF_MAIL_FROM vacios, mailer.py omite el envio
# (el resto del pipeline sigue funcionando sin problemas).
CMF_SMTP_HOST=smtp.tu-organizacion.cl
CMF_SMTP_PORT=587
CMF_SMTP_USER=cmf-monitor
CMF_SMTP_PASS=
# starttls | ssl | none
CMF_SMTP_TLS=starttls

CMF_MAIL_FROM=CMF Monitor <cmf-monitor@tu-organizacion.cl>
# Multiples destinatarios separados por coma.
CMF_MAIL_TO_NUEVAS=tareas@tu-organizacion.cl
CMF_MAIL_TO_ASIGNADOS=tareas@tu-organizacion.cl

# Asuntos (admiten $n = cantidad, $fecha = fecha en DD/MM/YYYY)
CMF_MAIL_SUBJECT_NUEVAS=[CMF Monitor] $n nueva(s) entidad(es) sin codigo de institucion -- $fecha
CMF_MAIL_SUBJECT_ASIGNADOS=[CMF Monitor] $n codigo(s) de institucion recien asignado(s) -- $fecha
